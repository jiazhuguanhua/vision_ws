<?xml version="1.0"?>
<launch>
  <!-- 无人机巡逻系统主启动文件 -->
  
  <!-- 参数配置 -->
  <rosparam file="$(find drone_patrol)/config/drone_patrol_params.yaml" command="load" />
  
  <!-- 通信链路节点 -->
  <node name="link_comm" pkg="drone_patrol" type="link_comm.py" output="screen">
    <param name="uart_port" value="/dev/ttyUSB0" />
    <param name="uart_baudrate" value="115200" />
    <param name="ble_enabled" value="true" />
    <param name="status_rate" value="1.0" />
  </node>
  
  <!-- 飞行控制节点 -->
  <node name="flight_control" pkg="drone_patrol" type="flight_control.py" output="screen">
    <param name="takeoff_altitude" value="1.2" />
    <param name="cruise_speed" value="1.0" />
    <param name="position_tolerance" value="0.3" />
    <param name="status_rate" value="10.0" />
  </node>
  
  <!-- 动物检测节点 -->
  <node name="animal_detect" pkg="drone_patrol" type="animal_detect.py" output="screen">
    <param name="camera_index" value="0" />
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="detection_rate" value="5.0" />
    <param name="confidence_threshold" value="0.5" />
    <param name="nms_threshold" value="0.4" />
    <param name="yolo_weights" value="/home/micoair/yolo/yolov4.weights" />
    <param name="yolo_config" value="/home/micoair/yolo/yolov4.cfg" />
    <param name="yolo_classes" value="/home/micoair/yolo/coco.names" />
    <param name="apriltag_enabled" value="true" />
    <param name="laser_enabled" value="true" />
    <param name="auto_track" value="true" />
  </node>
  
  <!-- 降落模式节点 -->
  <node name="landing_mode" pkg="drone_patrol" type="landing_mode.py" output="screen">
    <param name="landing_speed" value="0.5" />
    <param name="descent_angle" value="45.0" />
    <param name="minimum_altitude" value="0.2" />
    <param name="safety_radius" value="2.0" />
    <param name="led_enabled" value="true" />
    <param name="led_pin" value="18" />
  </node>
  
  <!-- 航点规划节点 (已存在) -->
  <node name="waypoint_planner" pkg="vision_msgs" type="waypoint_planner.py" output="screen">
    <param name="grid_size" value="9" />
    <param name="cell_size" value="5.0" />
    <param name="default_height" value="1.2" />
  </node>
  
  <!-- 激光控制节点 (已存在) -->
  <node name="laser_controller" pkg="vision_msgs" type="laser_controller.py" output="screen">
    <param name="laser_pin" value="12" />
    <param name="servo_x_pin" value="13" />
    <param name="servo_y_pin" value="15" />
  </node>
  
  <!-- MAVROS节点 (如果未在其他地方启动) -->
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="udp://:14540@127.0.0.1:14557" />
    <arg name="gcs_url" value="" />
    <arg name="tgt_system" value="1" />
    <arg name="tgt_component" value="1" />
  </include>
  
  <!-- RViz可视化 (可选) -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find drone_patrol)/rviz/drone_patrol.rviz" if="$(arg rviz)" />
  <arg name="rviz" default="false" />
  
  <!-- USB摄像头节点 -->
  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device" value="/dev/video0" />
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="camera_frame_id" value="usb_cam" />
    <param name="io_method" value="mmap"/>
  </node>
  
  <!-- 图像查看器 (可选) -->
  <node name="image_view" pkg="image_view" type="image_view" if="$(arg image_view)">
    <remap from="image" to="/drone_patrol/detection_image" />
  </node>
  <arg name="image_view" default="false" />
  
</launch>
