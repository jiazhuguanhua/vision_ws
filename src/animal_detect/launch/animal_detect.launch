<?xml version="1.0"?>
<launch>
  <!-- 动物检测节点启动文件 -->
  
  <!-- USB摄像头节点 (如果需要) -->
  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" unless="false">
    <param name="video_device" value="/dev/video0" />
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="camera_frame_id" value="camera" />
    <param name="io_method" value="mmap"/>
    <remap from="/usb_cam/image_raw" to="/camera/image_raw" />
  </node>

  <!-- 动物检测节点 -->
  <node name="animal_detect" pkg="animal_detect" type="animal_detect_node.py" output="screen">
    <!-- 摄像头参数 -->
    <param name="camera_index" value="0" />
    <param name="camera_frame_id" value="camera" />
    
    <!-- 模型参数 -->
    <param name="model_path" value="$(find animal_detect)/best.pt" />
    <param name="confidence_threshold" value="0.5" />
    <param name="detection_rate" value="2.0" />
  </node>

  <!-- 参数 -->
  <arg name="use_external_camera" default="false" doc="Use external camera feed instead of USB camera" />

</launch>
